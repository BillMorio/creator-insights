# Postgres (Render: creator-insights-db). Use the EXTERNAL URL for local dev,
# the INTERNAL URL on Render services.
DATABASE_URL=postgresql://user:pass@host:5432/creator_insights

# Apify — the grid actor that returns posts WITH play_count (reel views).
APIFY_TOKEN=
APIFY_IG_ACTOR=

# How many recent posts to pull per creator.
POSTS_LIMIT=100

# Worker poll interval (seconds).
POLL_SECONDS=5
